{
  "name": "signalk-alarm-silencer",
  "version": "1.8.2",
  "description": "Plugin to silence SignalK Alarms",
  "main": "dist/index.js",
  "scripts": {
    "test": "$NODE $npm_package_main",
    "create-release": "github-create-release --owner sbender9 --repository signalk-alarm-silencer",
    "release": "git tag -d v$npm_package_version && git tag v$npm_package_version && git push --tags && git push && npm run create-release",
    "lint": "eslint --fix",
    "prettier": "prettier --write ./src/*",
    "ci-lint": "eslint && prettier --check .",
    "format": "npm run prettier && npm run lint",
    "build": "tsc -b --pretty false",
    "watch": "tsc --watch --pretty false",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin"
  ],
  "author": "scott@scottbender.net",
  "license": "ISC",
  "dependencies": {
    "@canboat/ts-pgns": "^1.8.1",
    "lodash": "^4.17.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sbender9/signalk-alarm-silencer"
  },
  "devDependencies": {
    "@signalk/github-create-release": "^1.2.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/semver": "^7.7.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier-standard": "^16.4.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  }
}
